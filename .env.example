# Copy to .env and fill in. Never commit .env.

# Providers
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
EXA_API_KEY=...
AI_GATEWAY_API_KEY=          # Jev classifier via Vercel AI Gateway (phase 04, D-43); needed only
                              # when CLASSIFIER_PROVIDER=jev. Free evaluation credits need a card on file with Vercel
SEARCH_PROVIDER=exa          # exa | fake
LLM_PROVIDER=openai          # openai | fake

# Database
DATABASE_URL=postgresql+psycopg://podcast:podcast@localhost:5432/podcast

# Auth
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173   # comma-separated allowed frontend origins
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo
SEED_EVAL_USER_EMAIL=eval@example.com     # classifier-eval user (phase 04 Part B, D-29); is_synthetic
SEED_EVAL_USER_PASSWORD=eval

# Models (IDs confirmed against the key in phase 00, see docs/DECISIONS.md D-09)
MODEL_PROFILE=gpt-6-sol
MODEL_PLANNER=gpt-6-luna
MODEL_CLASSIFIER=gpt-6-sol     # D-45/D-61 eval verdict; gpt-6-luna is ~20x cheaper, Jev = CLASSIFIER_PROVIDER=jev
MODEL_CLASSIFIER_REASONING=none  # D-61: low/medium measured, no quality gain for the classifier
MODEL_SCRIPT=gpt-6-sol
MODEL_SCRIPT_REASONING=medium
MODEL_GROUNDING=gpt-6-luna
MODEL_GROUNDING_REASONING=low  # D-61: medium cut verdict flips only 12% at 1.26x cost
MODEL_JEV=typesafe-ai/jev    # Vercel AI Gateway model slug, used when CLASSIFIER_PROVIDER=jev (D-43)
OPENAI_TIMEOUT_S=90           # per OpenAI request (SDK default is 10 min); the client retries once (D-61)
JEV_TIMEOUT_S=30             # per-request timeout (each attempt) before retry / fallback (D-45)
JEV_MAX_ATTEMPTS=3           # attempts on 502/503/504/transport errors before falling back to MODEL_CLASSIFIER (D-45)
JEV_RATE_LIMIT_COOLDOWN_S=300  # after a 429, skip Jev (MODEL_CLASSIFIER scores instead) for this long (D-45)
CLASSIFIER_PROVIDER=openai   # openai | jev | fake -- see D-45 for the classifier eval verdict

# TTS
TTS_PROVIDER=elevenlabs      # elevenlabs | fake
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128   # pcm_44100 confirmed available in phase 00
DEFAULT_VOICE_HOST_A=ErXwobaYiN019PkySvjV        # chosen in phase 00: Antoni, ErXwobaYiN019PkySvjV
DEFAULT_VOICE_HOST_B=21m00Tcm4TlvDq8ikWAM        # chosen in phase 00: Rachel, 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_USD_PER_1K_CHARS=0.11   # ESTIMATE: ~$0.10/min public v3 price / ~900 chars per spoken
                                    # minute (150 words x ~6 chars); this key can't read the real
                                    # plan price (D-09). Update if Prosper gives you the real rate.
ELEVENLABS_MAX_CONCURRENCY=4   # chunk requests in flight, process-wide; must stay under the
                               # plan's limit (Free 2, Starter 3, Creator 5). This key took 4 (D-56)
ELEVENLABS_MAX_ATTEMPTS=3      # per chunk; retries 429/5xx only

# Guardrails
MAX_TTS_CHARS_PER_EPISODE=12000
DAILY_SPEND_CAP_USD=5
# Dev only: fail each episode once at this stage (e.g. voicing) to try Retry.
# Ignored unless TTS_PROVIDER=fake. Leave empty normally.
FAKE_FAIL_ONCE_AT=

# Paths
DATA_DIR=./data
# Debug only: write every scripting sub-step and prompt to <dir>/<episode_id>/ (D-60)
# SCRIPT_TRACE_DIR=./data/tmp/scripts

# Logging (DEBUG, INFO, WARNING, ERROR) -- terminal output for the CLI and API
LOG_LEVEL=INFO
