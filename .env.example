# Copy to .env and fill in. Never commit .env.

# Providers
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
EXA_API_KEY=...
AI_GATEWAY_API_KEY=            # optional, Jev classifier (phase 04)
SEARCH_PROVIDER=exa          # exa | fake
LLM_PROVIDER=openai          # openai | fake

# Database
DATABASE_URL=postgresql+psycopg://podcast:podcast@localhost:5432/podcast

# Auth
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173   # comma-separated allowed frontend origins
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo
SEED_EVAL_USER_EMAIL=eval@example.com     # classifier-eval user (phase 04 Part B, D-29); is_synthetic
SEED_EVAL_USER_PASSWORD=eval

# Models (IDs confirmed against the key in phase 00, see docs/DECISIONS.md D-09)
MODEL_PROFILE=gpt-6-sol
MODEL_PLANNER=gpt-6-luna
MODEL_CLASSIFIER=gpt-6-luna
MODEL_SCRIPT=gpt-6-sol
MODEL_SCRIPT_REASONING=medium
MODEL_GROUNDING=gpt-6-luna
MODEL_GROUNDING_REASONING=low
CLASSIFIER_PROVIDER=openai   # openai | jev | fake

# TTS
TTS_PROVIDER=elevenlabs      # elevenlabs | fake
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128   # pcm_44100 confirmed available in phase 00
DEFAULT_VOICE_HOST_A=        # chosen in phase 00: Antoni, ErXwobaYiN019PkySvjV
DEFAULT_VOICE_HOST_B=        # chosen in phase 00: Rachel, 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_USD_PER_1K_CHARS=0.11   # ESTIMATE: ~$0.10/min public v3 price / ~900 chars per spoken
                                    # minute (150 words x ~6 chars); this key can't read the real
                                    # plan price (D-09). Update if Prosper gives you the real rate.

# Guardrails
MAX_TTS_CHARS_PER_EPISODE=12000
DAILY_SPEND_CAP_USD=5
# Dev only: fail each episode once at this stage (e.g. voicing) to try Retry.
# Ignored unless TTS_PROVIDER=fake. Leave empty normally.
FAKE_FAIL_ONCE_AT=

# Paths
DATA_DIR=./data

# Logging (DEBUG, INFO, WARNING, ERROR) -- terminal output for the CLI and API
LOG_LEVEL=INFO
